rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER SECURITY FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Checks for verified admin email or Firebase Custom Claims
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@eproducts.com' ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if (isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == resource.data.get('role', 'customer')
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. PRODUCTS COLLECTION (PUBLIC CATALOG)
    // ==========================================
    match /products/{productId} {
      // Anyone can browse products in the marketplace
      allow read: if true;
      // Authenticated sellers can upload new products
      allow create: if isAuthenticated();
      // Product sellers and admins can update everything;
      // Buyers can update viewCount and salesCount statistics
      allow update: if (
        (isAuthenticated() && (resource.data.get('sellerId', '') == request.auth.uid || isAdmin())) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salesCount', 'stockQuantity']))
      );
      // Only the product seller or an admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.get('sellerId', '') == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 3. CATEGORIES COLLECTION
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. ORDERS COLLECTION
    // ==========================================
    match /orders/{orderId} {
      // Buyers can view their own orders; admins can view all orders
      allow read: if isAuthenticated() && (
        resource.data.get('buyerId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid || 
        isAdmin()
      );
      // Authenticated users can place new orders
      allow create: if isAuthenticated();
      // Buyers can cancel; admins can update status
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.get('buyerId', '') == request.auth.uid && request.resource.data.get('orderStatus', '') == 'Cancelled')
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. CARTS COLLECTION
    // ==========================================
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // 6. WISHLISTS COLLECTION
    // ==========================================
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // 7. REVIEWS COLLECTION
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 8. PRODUCT VIEWS & ANALYTICS
    // ==========================================
    match /productViews/{viewId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Catch-all: deny any unmatched path
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
