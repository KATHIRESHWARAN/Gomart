rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER SECURITY FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Checks for trusted Firebase Custom Claim { admin: true }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    // Customers can only view and update their own profile.
    // Admins have read and management access.
    // Role privilege escalation is prohibited during normal user updates.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. PRODUCTS COLLECTION
    // ==========================================
    // Public can read all approved products.
    // Only sellers can create listings, and only admins/owners can update/delete.
    match /products/{productId} {
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 3. CATEGORIES COLLECTION
    // ==========================================
    // Public catalog browsing of categories. Admin write/delete.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. ORDERS COLLECTION
    // ==========================================
    // Buyers can only see their own orders.
    // Admins can inspect and update all orders across the platform.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.buyerId == request.auth.uid && request.resource.data.orderStatus == 'Cancelled')
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. CARTS COLLECTION
    // ==========================================
    // Each customer has a private cart document keyed by their user ID.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 6. WISHLISTS COLLECTION
    // ==========================================
    // Each customer has a private wishlist document keyed by their user ID.
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 7. REVIEWS COLLECTION
    // ==========================================
    // Anyone can read reviews for products.
    // Authenticated buyers can submit reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 8. PRODUCT VIEWS & ANALYTICS
    // ==========================================
    match /productViews/{viewId} {
      allow create: if true;
      allow read: if isAdmin();
    }

  }
}
