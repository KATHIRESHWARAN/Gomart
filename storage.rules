rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Thumbnails: publicly readable for marketplace cards, uploadable by authenticated users
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Digital downloadable deliverable files:
    // Readable and uploadable by authenticated users
    match /products/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
