PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Security Initialization
ADMIN_EMAIL=admin@eproducts.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Administrator

# Firebase Admin SDK Configuration
# Option 1: Full JSON string in a single variable (Easiest for Render deployment)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"gomart-4615b",...}

# Option 2: Individual variables from Firebase Service Account JSON
FIREBASE_PROJECT_ID=gomart-4615b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=gomart-4615b.firebasestorage.app

# Option 3: Path to downloaded Service Account JSON file (local dev only)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
